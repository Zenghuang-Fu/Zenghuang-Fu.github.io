<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="author" content="Zenghuang Fu">
    <meta
      name="description"
      content="Zenghuang Fu — MSc student at CASIA, researching agentic reinforcement learning, self-evolving agents and multimodal understanding."
    >
    <meta property="og:title" content="Zenghuang Fu | CASIA">
    <meta property="og:description" content="Agentic reinforcement learning, self-evolving agents and multimodal understanding.">
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ page.url | absolute_url }}">
    <meta property="og:image" content="{{ '/assets/img/prof_pic.jpg' | absolute_url }}">
    <title>
      {% unless page.home %}{{ page.title | capitalize }} | {% endunless %}
      Zenghuang Fu
    </title>
    <link rel="canonical" href="{{ page.url | absolute_url }}">
    <link rel="icon" href="{{ '/assets/academic/favicon.svg' | relative_url }}" type="image/svg+xml">
    <link rel="stylesheet" href="{{ '/assets/academic/style.css' | relative_url }}">
    <script src="{{ '/assets/academic/site.js' | relative_url }}" defer></script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header class="site-header">
      <nav class="site-nav" aria-label="Primary navigation">
        <a class="site-name" href="{{ '/' | relative_url }}">Zenghuang Fu</a>
        <div class="desktop-nav">{% include academic-nav.liquid %}</div>
        <details class="mobile-nav">
          <summary>Menu</summary>
          <div class="mobile-nav-panel">{% include academic-nav.liquid %}</div>
        </details>
      </nav>
    </header>
    <div class="site-layout">
      <aside class="profile-sidebar" aria-label="Profile">
        <a class="portrait-link" href="{{ '/' | relative_url }}" aria-label="Zenghuang Fu home"
          ><img
            class="profile-photo"
            src="{{ '/assets/img/prof_pic.jpg' | relative_url }}"
            alt="Portrait of Zenghuang Fu"
            width="180"
            height="180"
            fetchpriority="high"
        ></a>
        <h1>Zenghuang Fu</h1>
        <p class="profile-role">MSc Student</p>
        <p class="affiliation">
          <a href="http://english.ia.cas.cn/"
            >Institute of Automation<br>
            Chinese Academy of Sciences</a
          >
        </p>
        <p class="profile-location">Beijing, China</p>
        <p class="profile-focus">
          Agentic reinforcement learning,<br>
          self-evolving agents, and<br>
          multimodal understanding.
        </p>
        <nav class="profile-links" aria-label="Contact and profiles">
          <a href="mailto:{{ site.data.socials.email }}"><span aria-hidden="true">✉</span>Email</a>
          <a href="https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid }}"
            ><span aria-hidden="true">↗</span>Google Scholar</a
          >
          <a href="https://github.com/{{ site.data.socials.github_username }}"><span aria-hidden="true">⌘</span>GitHub</a>
          <a href="{{ '/cv/' | relative_url }}"><span aria-hidden="true">▤</span>Curriculum Vitae</a>
          <a href="{{ site.data.socials.xiaohongshu.url }}"><span aria-hidden="true">↗</span>Xiaohongshu</a>
        </nav>
      </aside>
      <main id="main-content" class="content-column">
        {% if page.home %}
          <section id="about" class="about-section" aria-label="About">{{ content }}</section>
          {% include academic-home.liquid %}
        {% else %}
          <div class="section-heading page-heading">
            <h2>{{ page.title | capitalize }}</h2>
            {% if page.cv_pdf -%}
              <a class="text-link" href="{{ page.cv_pdf | relative_url }}">Download PDF ↗</a>
            {%- endif %}
          </div>
          {% if page.description %}
            <p class="page-description">{{ page.description }}</p>
          {% endif %}
          {% case page.academic_section %}
            {% when 'news' %}
              {% include academic-news.liquid %}
            {% when 'publications' %}
              <div class="academic-publications">{% bibliography --template academic-bib %}</div>
            {% when 'resources' %}
              {% include academic-resources.liquid %}
              <div class="section-heading section"><h2>More on GitHub</h2></div>
              <ul class="repository-list">
                {% for repo in site.data.repositories.github_repos %}
                  <li>
                    <a href="https://github.com/{{ repo }}">{{ repo | split: '/' | last }} ↗</a>
                  </li>
                {% endfor %}
              </ul>
            {% else %}
              {{ content }}
          {% endcase %}
        {% endif %}
        <footer class="site-footer">
          <span>© {{ site.time | date: '%Y' }} Zenghuang Fu</span><a href="{{ '/' | relative_url }}#about">Back to top ↑</a>
        </footer>
      </main>
    </div>
  </body>
</html>
