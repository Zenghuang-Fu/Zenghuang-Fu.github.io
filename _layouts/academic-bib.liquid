<article class="publication" id="{{ entry.key }}">
  {% if entry.preview -%}
    <a
      class="publication-image"
      href="{% if entry.doi %}https://doi.org/{{ entry.doi }}{% elsif entry.arxiv %}https://arxiv.org/abs/{{ entry.arxiv }}{% else %}#{{ entry.key }}{% endif %}"
      aria-label="Read {{ entry.title | escape }}"
      ><img
        src="{{ entry.preview | prepend: '/assets/img/publication_preview/' | relative_url }}"
        alt="Overview of {{ entry.title | escape }}"
        loading="lazy"
        width="180"
        height="120"
    ></a>
  {%- endif %}
  <div class="publication-body">
    <span class="venue-tag">
      {{- entry.abbr }}
      {{ entry.year -}}
    </span>
    <h3>
      <a href="{% if entry.doi %}https://doi.org/{{ entry.doi }}{% elsif entry.arxiv %}https://arxiv.org/abs/{{ entry.arxiv }}{% else %}#{{ entry.key }}{% endif %}">
        {{- entry.title -}}
      </a>
    </h3>
    <p class="authors">
      {% assign authors = entry.author | split: ' and ' -%}
      {%- for author in authors -%}
        {%- assign name = author | split: ', ' -%}
        {%- if author contains 'Fu' and author contains 'Zenghuang' %}<strong>{% endif -%}
        {{- name.last }}
        {{ name.first | replace: '∗', '<sup>∗</sup>' | replace: '†', '<sup>†</sup>' -}}
        {%- if author contains 'Fu' and author contains 'Zenghuang' %}</strong>{% endif -%}
        {%- unless forloop.last %}, {% endunless -%}
      {%- endfor %}
    </p>
    <p class="publication-venue">
      {% if entry.journal %}{{ entry.journal }}{% else %}{{ entry.booktitle }}{% endif %}, {{ entry.year }}
    </p>
    <div class="publication-links">
      {% if entry.doi -%}
        <a href="https://doi.org/{{ entry.doi }}">Paper ↗</a>
      {%- endif %}
      {% if entry.arxiv -%}
        <a href="https://arxiv.org/abs/{{ entry.arxiv }}">arXiv ↗</a>
      {%- endif %}
      {% if entry.code -%}
        <a href="{{ entry.code }}">Code ↗</a>
      {%- endif %}
      <details class="bibtex">
        <summary>BibTeX</summary>
        <pre><code>{{ entry.bibtex | escape }}</code></pre>
      </details>
    </div>
  </div>
</article>
