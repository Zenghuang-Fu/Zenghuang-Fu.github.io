<aside class="opportunity-notice" aria-label="PhD opportunities">
  <span class="notice-icon" aria-hidden="true">🎓</span>
  <div>
    <strong>Looking for PhD opportunities</strong>
    <p>
      I am actively looking for PhD positions. If my research interests align with your group, please
      <a href="mailto:{{ site.data.socials.email }}">get in touch</a>.
    </p>
  </div>
</aside>
<section id="research" class="section" aria-labelledby="research-title">
  <div class="section-heading">
    <h2 id="research-title"><span aria-hidden="true">🔬</span> Research</h2>
  </div>
  <div class="research-grid">
    <article class="research-card">
      <h3>Agentic Reinforcement Learning</h3>
      <p>Long-horizon credit assignment and policy optimization for multi-turn agents.</p>
      <div class="tag-list"><span>Credit Assignment</span><span>Agentic RL</span></div>
      <a class="text-link" href="#fu2026uniopsd">UniOPSD &amp; SIPO →</a>
    </article>
    <article class="research-card">
      <h3>Search &amp; Self-Evolving Agents</h3>
      <p>Agentic search, skill evolution, memory, and autonomous research workflows.</p>
      <div class="tag-list"><span>Self-Evolution</span><span>AutoResearch</span></div>
      <a class="text-link" href="#fu2026sesa">SESA &amp; CoEvoKG →</a>
    </article>
    <article class="research-card">
      <h3>Agentic Memory</h3>
      <p>Persistent memory and knowledge for long-horizon DeepResearch agents.</p>
      <div class="tag-list"><span>Long-Horizon Agents</span><span>Memory</span></div>
      <a class="text-link" href="#ai2026cognitive">Cognitive Scaffold →</a>
    </article>
    <article class="research-card">
      <h3>Multimodal Understanding</h3>
      <p>Long-video understanding with multimodal LLMs, robot vision, and robust visual perception.</p>
      <div class="tag-list"><span>Video Understanding</span><span>Robot Vision</span></div>
      <a class="text-link" href="#jia2026explicit">Explore related work →</a>
    </article>
  </div>
</section>
<section id="news" class="section" aria-labelledby="news-title">
  <div class="section-heading">
    <h2 id="news-title"><span aria-hidden="true">🔥</span> News</h2>
    <a class="text-link" href="{{ '/news/' | relative_url }}">All news →</a>
  </div>
  {% include academic-news.liquid limit=5 %}
  <details class="news-archive">
    <summary>Earlier news</summary>
    {% include academic-news.liquid offset=5 %}
  </details>
</section>
<section id="publications" class="section" aria-labelledby="publications-title">
  <div class="section-heading">
